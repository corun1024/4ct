-- selecting the rules of an arity from `theDrules` is a second of kernel time;
-- done here once instead of inside every one of the checks below
/-- The discharge rules of arity 9, as a literal. -/
def rf9 : DruleFork Part.conversePart 9 :=
  ⟨src9, tgt9, by decide +kernel, by decide +kernel⟩

/-- `succeed_by_hubcap` against the precomputed rule fork. -/
theorem succeed_by_hubcap9 (hredp : RedpartSound theRedpart) (hc : Hubcap)
    {p₀ p : Part} (hsz : p.size = 9) (h2 : 2 ≤ p.size)
    (hcover : hubcapCover p.size hc = true)
    (hfitc : hubcapFit theRedpart rf9 p hc = true) :
    SucceedsIn p₀ p := by
  refine succeed_by_hubcap hredp hc h2 hcover ?_
  rw [hsz, ← druleFork_uniq9 rf9]
  exact hfitc

