/-- Any `DruleFork` for this arity is the canonical one: the structure's proof
fields pin its data down. -/
theorem druleFork_uniq8 {conv : Part → PRange × Part} (rf : DruleFork conv 8) :
    rf = druleFork conv 8 := by
  cases rf with
  | mk _ _ hs ht => cases hs; cases ht; rfl

set_option maxRecDepth 100000 in
set_option maxHeartbeats 4000000 in
-- selecting the rules of an arity from `theDrules` is a second of kernel time;
-- done here once instead of inside every one of the checks below
/-- The discharge rules of arity 8, as a literal. -/
def rf8 : DruleFork Part.conversePart 8 :=
  ⟨src8, tgt8, by decide +kernel, by decide +kernel⟩

/-- `succeed_by_hubcap` against the precomputed rule fork. -/
theorem succeed_by_hubcap8 (hredp : RedpartSound theRedpart) (hc : Hubcap)
    {p₀ p : Part} (hsz : p.size = 8) (h2 : 2 ≤ p.size)
    (hcover : hubcapCover p.size hc = true)
    (hfitc : hubcapFit theRedpart rf8 p hc = true) :
    SucceedsIn p₀ p := by
  refine succeed_by_hubcap hredp hc h2 hcover ?_
  rw [hsz, ← druleFork_uniq8 rf8]
  exact hfitc

