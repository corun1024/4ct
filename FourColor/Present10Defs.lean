  ⟨src10, tgt10, by decide +kernel, by decide +kernel⟩

/-- `succeed_by_hubcap` against the precomputed rule fork. -/
theorem succeed_by_hubcap10 (hredp : RedpartSound theRedpart) (hc : Hubcap)
    {p₀ p : Part} (hsz : p.size = 10) (h2 : 2 ≤ p.size)
    (hcover : hubcapCover p.size hc = true)
    (hfitc : hubcapFit theRedpart rf10 p hc = true) :
    SucceedsIn p₀ p := by
  refine succeed_by_hubcap hredp hc h2 hcover ?_
  rw [hsz, ← druleFork_uniq10 rf10]
  exact hfitc

