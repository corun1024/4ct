theorem mapChunk0 {α β : Type*} {f : α → β} (n : ℕ) {l : List α} {m : List β}
    (h₁ : (l.take n).map f = m.take n) (h₂ : (l.drop n).map f = m.drop n) :
    l.map f = m := by
  rw [← List.take_append_drop n l, List.map_append, h₁, h₂, List.take_append_drop]

/-- The same, `k` entries in: the equation on the `n` entries after the first
`k` and the one on what follows them make up the equation from `k` on. -/
theorem mapChunk {α β : Type*} {f : α → β} (n k : ℕ) {l : List α} {m : List β}
    (h₁ : ((l.drop k).take n).map f = (m.drop k).take n)
    (h₂ : (l.drop (k + n)).map f = m.drop (k + n)) :
    (l.drop k).map f = m.drop k := by
  rw [← List.take_append_drop n (l.drop k), List.map_append, h₁, List.drop_drop, h₂,
    ← List.drop_drop, List.take_append_drop]

