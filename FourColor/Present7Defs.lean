/-- Any `DruleFork` for this arity is the canonical one: the structure's proof
fields pin its data down. -/
theorem druleFork_uniq7 {conv : Part → PRange × Part} (rf : DruleFork conv 7) :
    rf = druleFork conv 7 := by
  cases rf with
  | mk _ _ hs ht => cases hs; cases ht; rfl

set_option maxRecDepth 100000 in
set_option maxHeartbeats 4000000 in
-- selecting the rules of an arity from `theDrules` is a second of kernel time;
-- done here once instead of inside every one of the checks below
/-- The discharge rules of arity 7, as a literal. -/
def rf7 : DruleFork Part.conversePart 7 :=
  ⟨src7, tgt7, by decide +kernel, by decide +kernel⟩

/-- `succeed_by_hubcap` against the precomputed rule fork. -/
theorem succeed_by_hubcap7 (hredp : RedpartSound theRedpart) (hc : Hubcap)
    {p₀ p : Part} (hsz : p.size = 7) (h2 : 2 ≤ p.size)
    (hcover : hubcapCover p.size hc = true)
    (hfitc : hubcapFit theRedpart rf7 p hc = true) :
    SucceedsIn p₀ p := by
  refine succeed_by_hubcap hredp hc h2 hcover ?_
  rw [hsz, ← druleFork_uniq7 rf7]
  exact hfitc

